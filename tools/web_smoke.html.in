<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>island-simulator WebGL 2 smoke test</title>
  <style>
    html, body { width: 100%; height: 100%; margin: 0; overflow: hidden; background: #152a32; }
    body { display: flex; align-items: center; justify-content: center; }
    canvas {
      display: block;
      width: min(100vw, 177.777778vh);
      height: min(100vh, 56.25vw);
      background: #152a32;
    }
    pre { display: none; }
  </style>
</head>
<body>
  <canvas id="canvas" width="1280" height="720" tabindex="-1"></canvas>
  <pre id="output"></pre>
  <script>
    const output = document.getElementById("output");
    globalThis.islandSmokeResult = { exited: false, exitCode: null, output: "", error: "" };
    // Observe input ordering without requesting focus/capture or altering propagation. Keep
    // the first bounded sequence so a later noisy scene cannot erase the activation evidence.
    globalThis.islandSmokeResult.inputEvents = [];
    globalThis.islandSmokeResult.droppedInputEvents = 0;
    const recordInputEvent = event => {
      const result = globalThis.islandSmokeResult;
      if (result.inputEvents.length >= 128) { ++result.droppedInputEvents; return; }
      const canvas = document.getElementById("canvas");
      result.inputEvents.push({ type: event.type, milliseconds: performance.now(),
        trusted: event.isTrusted, button: event.button ?? null, buttons: event.buttons ?? null,
        targetIsCanvas: event.target === canvas, focused: document.hasFocus(),
        canvasActive: document.activeElement === canvas,
        pointerLocked: document.pointerLockElement === canvas });
    };
    for (const type of ["mousedown", "mouseup", "pointerlockchange", "pointerlockerror", "focus", "blur"]) {
      document.addEventListener(type, recordInputEvent, { capture: true, passive: true });
    }
    const record = (prefix, values) => {
      const line = prefix + values.join(" ");
      globalThis.islandSmokeResult.output += line + "\n";
      output.textContent = globalThis.islandSmokeResult.output;
      console.log(line);
    };
    const mode = new URLSearchParams(location.search).get("mode") ?? "smoke";
    const modeArguments = new Map([
      ["flight", ["--input-diagnostics"]],
      ["monkey-climb", ["--viewpoint", "monkey-climb"]],
      ["snakes", ["--viewpoint", "snakes"]],
      ["hut", ["--viewpoint", "hut", "--debug-overlay"]],
      ["hut-material", ["--viewpoint", "hut-material", "--debug-overlay"]],
      ["cave", ["--viewpoint", "cave", "--debug-overlay"]],
      ["cave-top", ["--viewpoint", "cave-top", "--debug-overlay"]],
      ["cave-inside", ["--viewpoint", "cave-inside", "--debug-overlay"]],
      ["bunker", ["--viewpoint", "bunker", "--debug-overlay"]],
      ["bunker-corridor", ["--viewpoint", "bunker-corridor", "--debug-overlay"]],
      ["bunker-computers", ["--viewpoint", "bunker-computers", "--debug-overlay"]],
      ["bunker-reactor", ["--viewpoint", "bunker-reactor", "--debug-overlay"]],
      ["bunker-service", ["--viewpoint", "bunker-service", "--debug-overlay"]],
      ["bunker-end", ["--viewpoint", "bunker-end", "--debug-overlay"]],
      ["stream", ["--viewpoint", "stream", "--debug-overlay"]],
      ["wetland", ["--viewpoint", "wetland", "--debug-overlay"]],
      ["campfire", ["--viewpoint", "campfire", "--debug-overlay"]],
      ["snake-head", ["--viewpoint", "snake-head"]],
      ["tree-snakes", ["--viewpoint", "tree-snakes"]],
      ["interactive", []],
      ["input", ["--debug-overlay", "--input-diagnostics"]],
      ["grass-motion", ["--debug-overlay", "--input-diagnostics"]],
      ["overview", ["--overview"]],
      ["bay", ["--viewpoint", "bay", "--debug-overlay"]],
      ["bay-ground", ["--viewpoint", "bay-ground", "--debug-overlay"]],
      ["wet-sand", ["--viewpoint", "wet-sand", "--debug-overlay"]],
      ["headland", ["--viewpoint", "headland", "--debug-overlay"]],
      ["beach", ["--viewpoint", "beach"]],
      ["beach", ["--viewpoint", "beach", "--debug-overlay"]],
      ["grass", ["--viewpoint", "grass", "--debug-overlay"]],
      ["ground", ["--viewpoint", "ground", "--debug-overlay"]],
      ["ground-broadleaf", ["--viewpoint", "ground-broadleaf", "--debug-overlay"]],
      ["bush", ["--viewpoint", "bush", "--debug-overlay"]],
      ["litter", ["--viewpoint", "litter", "--debug-overlay"]],
      ["palms", ["--viewpoint", "palms", "--debug-overlay"]],
      ["fallen-palm", ["--viewpoint", "fallen-palm", "--debug-overlay"]],
      ["broken-palm", ["--viewpoint", "broken-palm", "--debug-overlay"]],
      ["mangroves", ["--viewpoint", "mangroves", "--debug-overlay"]],
      ["jungle", ["--viewpoint", "jungle", "--debug-overlay"]],
      ["snags", ["--viewpoint", "snags", "--debug-overlay"]],
      ["sapling", ["--viewpoint", "sapling", "--debug-overlay"]],
      ["east", ["--viewpoint", "east", "--debug-overlay"]],
      ["clearing-edge", ["--viewpoint", "clearing-edge", "--debug-overlay"]],
      ["west", ["--viewpoint", "west", "--debug-overlay"]],
      ["props", ["--viewpoint", "props", "--debug-overlay"]],
      ["contact", ["--viewpoint", "contact", "--debug-overlay"]],
      ["driftwood", ["--viewpoint", "driftwood", "--debug-overlay"]],
      ["reef", ["--viewpoint", "reef", "--debug-overlay"]],
      ["shipwreck", ["--viewpoint", "shipwreck", "--debug-overlay"]],
      ["crabs", ["--viewpoint", "crabs", "--debug-overlay"]],
      ["hermit-crabs", ["--viewpoint", "hermit-crabs", "--debug-overlay"]],
      ["coconut-crabs", ["--viewpoint", "coconut-crabs", "--debug-overlay"]],
      ["crocodiles", ["--viewpoint", "crocodiles", "--debug-overlay"]],
      ["butterflies", ["--viewpoint", "butterflies", "--debug-overlay"]],
      ["geckos", ["--viewpoint", "geckos", "--debug-overlay"]],
      ["skinks", ["--viewpoint", "skinks", "--debug-overlay"]],
      ["dragonflies", ["--viewpoint", "dragonflies", "--debug-overlay"]],
      ["frogs", ["--viewpoint", "frogs", "--debug-overlay"]],
      ["mice", ["--viewpoint", "mice", "--debug-overlay"]],
      ["rats", ["--viewpoint", "rats", "--debug-overlay"]],
      ["flies", ["--viewpoint", "flies", "--debug-overlay"]],
      ["ants", ["--viewpoint", "ants", "--debug-overlay"]],
      ["cicadas", ["--viewpoint", "cicadas", "--debug-overlay"]],
      ["beetles", ["--viewpoint", "beetles", "--debug-overlay"]],
      ["water", ["--viewpoint", "water", "--debug-overlay"]],
      ["current", ["--viewpoint", "current", "--debug-overlay"]],
      ["distant", ["--viewpoint", "distant", "--debug-overlay"]],
      ["fronds", ["--viewpoint", "fronds", "--debug-overlay"]],
      ["birds", ["--viewpoint", "birds", "--debug-overlay"]],
      ["ground-doves", ["--viewpoint", "ground-doves", "--debug-overlay"]],
      ["bats", ["--viewpoint", "bats", "--debug-overlay"]],
      ["bat-roost", ["--viewpoint", "bat-roost", "--debug-overlay"]],
      ["fish", ["--viewpoint", "fish", "--debug-overlay"]],
      ["stingrays", ["--viewpoint", "stingrays", "--debug-overlay"]],
      ["octopuses", ["--viewpoint", "octopuses", "--debug-overlay"]],
      ["turtles", ["--viewpoint", "turtles", "--debug-overlay"]],
      ["shark", ["--viewpoint", "shark", "--debug-overlay"]],
      ["dolphins", ["--viewpoint", "dolphins", "--debug-overlay"]],
      ["bear", ["--viewpoint", "bear", "--debug-overlay"]],
      ["resident", ["--viewpoint", "resident", "--debug-overlay"]],
      ["helicopter", ["--viewpoint", "helicopter", "--debug-overlay"]],
      ["helicopter-inside", ["--viewpoint", "helicopter-inside", "--debug-overlay"]],
      ["helicopter-approach", ["--viewpoint", "helicopter-approach", "--debug-overlay"]],
      ["monkeys", ["--viewpoint", "monkeys"]],
      ["goats", ["--viewpoint", "goats"]],
      ["deer", ["--viewpoint", "deer"]],
      ["spiders", ["--viewpoint", "spiders"]],
      ["spider-web", ["--viewpoint", "spider-web"]],
      ["boars", ["--viewpoint", "boars"]],
    ]);
    var Module = {
      arguments: ["--no-user-settings", ...(modeArguments.get(mode) ?? ["--smoke-test"])],
      canvas: document.getElementById("canvas"),
      print: (...values) => record("", values),
      printErr: (...values) => record("ERR: ", values),
      onAbort: (reason) => {
        globalThis.islandSmokeResult.error = String(reason);
      },
      onExit: (code) => {
        globalThis.islandSmokeResult.exited = true;
        globalThis.islandSmokeResult.exitCode = code;
      }
    };
    Module.canvas.addEventListener("mousedown", event => {
      if (event.button === 0 && document.pointerLockElement !== Module.canvas) {
        Module.canvas.requestPointerLock();
      }
    });
    window.addEventListener("error", event => {
      globalThis.islandSmokeResult.error = event.error?.stack ?? event.message;
    });
    window.addEventListener("unhandledrejection", event => {
      globalThis.islandSmokeResult.error = event.reason?.stack ?? String(event.reason);
    });
  </script>
  <script async src="island-simulator.js"></script>
</body>
</html>
